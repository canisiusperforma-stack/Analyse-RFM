# Nom et description de l'application
APP_NAME=Plateforme RFM SRB Vatovavy
APP_DESCRIPTION=API d'analyse, de prevision et d'aide a la decision du RFM
APP_VERSION=1.0.0

# Environnement : development | testing | production
APP_ENV=development
DEBUG=true

# Serveur
API_HOST=127.0.0.1
API_PORT=8000

# CORS : liste d'origines separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Journalisation
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rfm_srb_vatovavy

# Sécurité JWT (obligatoire : valeur différente du défaut en production)
JWT_SECRET=dev-secret-a-changer-absolument
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=rfm-srb-vatovavy

# Assistant IA (LLM) - API compatible OpenAI (Ollama, vLLM, LM Studio, ...)
# Désactivé par défaut : l'assistant répond alors avec les données du backend,
# reformulées par le code, sans appel à un modèle.
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODELE=llama3.1
LLM_TEMPERATURE=0.0
LLM_TOKENS_MAX=900
LLM_DELAI_MAX=60
LLM_TOURS_HISTORIQUE=4
LLM_QUESTION_MAX=500
LLM_TOLERANCE_NUMERIQUE=0.01
LLM_SOURCES_MAX=12

# Recherche documentaire (RAG) sur les documents autorises du SRB.
# Desactive par defaut : aucune donnee documentaire n'est alors indexee
# ni transmise a un modele.
#   false -> les routes /documents/question, /documents/recherche et
#            /documents/{id}/indexer repondent 503. L'import, la liste, le
#            telechargement, la reclassification et la suppression restent
#            disponibles : la base reste administrable sans que son contenu
#            soit lu par un modele.
#   true  -> la base documentaire est operationnelle de bout en bout. Les index
#            MongoDB necessaires a la recherche sont crees au demarrage.
# Mettre a true pour utiliser le chatbot documentaire.
RAG_ENABLED=false
RAG_EXTENSIONS=pdf,txt,md,csv,json,xlsx
RAG_TAILLE_MAX_OCTETS=20971520
RAG_CHUNK_TAILLE=900
RAG_CHUNK_TAILLE_MIN=180
RAG_CHUNK_RECOUVREMENT=150
# local-hash : vecteurs de n-grammes hachés, calculés en local, sans modèle
# à télécharger, reproductibles d'un processus à l'autre.
RAG_EMBED_DIM=2048
RAG_EMBED_MODELE=local-hash
RAG_RECHERCHE_TOP_K=6
RAG_RECHERCHE_CANDIDATS=200
RAG_CONTEXTE_CARACTERES_MAX=12000
# Score minimal de pertinence : en dessous, aucune source n'est retenue et le
# chatbot déclare l'information introuvable sans appeler le modèle.
# Calibré sur le modèle d'embeddings par défaut : les questions pertinentes
# ressortent au-dessus de 0,33, les questions hors sujet en dessous de 0,18.
RAG_SEUIL_PERTINENCE=0.25
RAG_PONDERATION_DENSE=0.7
RAG_CITATIONS_EXIGEES=true
RAG_TEMPERATURE=0.0
RAG_TOKENS_MAX=900
RAG_HISTORIQUE_TOURS=4
RAG_QUESTION_MAX=500
RAG_EXTRACTION_AUTO=true
RAG_SOURCES_MIN=1

# ---------------------------------------------------------------------------
# Orchestration IA (routeur DATA / RAG / DATA_RAG)
# ---------------------------------------------------------------------------
# Le routeur de app.ai.query_router decide, pour chaque question, du chemin
# minimal a emprunter : base de donnees seule, documents seuls, les deux, ou
# aucune (question hors perimetre). Il n'interroge ni MongoDB, ni le vector
# store, ni le modele de langage pour decider ; il ne fait que classer.
#
# La fusion reste active meme lorsque RAG_ENABLED=false ou LLM_ENABLED=false :
# dans ce cas les branches documentaires renvoient une reponse d'absence
# explicite, et les chiffres proviennent toujours du backend.
ASSISTANT_FUSION_ENABLED=true
# Indice documentaire minimal pour basculer en RAG. Une mention isolee
# ("le solde global est-il conforme ?") reste une question de donnees : il
# faut que l'indice documentaire depasse ce seuil ET qu'un indicateur de la
# plateforme reste identifiable pour obtenir DATA_RAG.
ASSISTANT_ROUTEUR_SEUIL_RAG=0.34
# Indice de donnees minimal pour considerer la question comme portant sur les
# donnees RFM. En dessous, la question est traitee comme documentaire, ou
# rejetee comme hors perimetre.
ASSISTANT_ROUTEUR_SEUIL_DATA=0.30
# Mettre a false pour que le backend retienne automatiquement le plus recent
# exercice disponible au lieu de demander a l'utilisateur de preciser
# l'annee. true est la regle par defaut : choisir une annee sans y etre
# autorise reviendrait a repondre a une autre question que celle posee.
ASSISTANT_CLARIFICATION=true
# Seuil de pertinence documentaire propre a l'assistant. Vide = herite de
# RAG_SEUIL_PERTINENCE. Une valeur plus basse (0.20) est utile pour les
# questions de fusion, dont la formulation partage moins de mots avec la
# procedure recherchee.
ASSISTANT_RAG_SEUIL=
# Nombre d'extraits transmis au modele dans une question de fusion. Inferieur
# a RAG_RECHERCHE_TOP_K : le contexte combine contient deja les chiffres du
# backend, le budget de contexte est partage.
ASSISTANT_RAG_TOP_K=4
